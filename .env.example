# Local development environment template.
# Copy this file to .env, choose the profile explicitly, and replace every placeholder secret.
# Never commit real credentials, tokens, or provider keys.

# Spring
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:5173
# SERVER_PORT is set per service process; each module has its documented default.
API_RATE_REPLENISH=50
API_RATE_BURST=100
AUTH_RATE_REPLENISH=2
AUTH_RATE_BURST=5
AUTH_GENERAL_RATE_REPLENISH=5
AUTH_GENERAL_RATE_BURST=10
READ_RATE_REPLENISH=20
READ_RATE_BURST=40

# PostgreSQL
POSTGRES_USER=hau_exam
POSTGRES_PASSWORD=replace-with-postgres-password
AUTH_DB_URL=jdbc:postgresql://localhost:5432/auth_db
AUTH_DB_USERNAME=hau_exam
AUTH_DB_PASSWORD=replace-with-postgres-password
USER_DB_URL=jdbc:postgresql://localhost:5432/user_db
USER_DB_USERNAME=hau_exam
USER_DB_PASSWORD=replace-with-postgres-password
QUESTION_DB_URL=jdbc:postgresql://localhost:5432/question_db
QUESTION_DB_USERNAME=hau_exam
QUESTION_DB_PASSWORD=replace-with-postgres-password
EXAM_DB_URL=jdbc:postgresql://localhost:5432/exam_db
EXAM_DB_USERNAME=hau_exam
EXAM_DB_PASSWORD=replace-with-postgres-password
AI_DB_URL=jdbc:postgresql://localhost:5432/ai_db
AI_DB_USERNAME=hau_exam
AI_DB_PASSWORD=replace-with-postgres-password
NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5432/notification_db
NOTIFICATION_DB_USERNAME=hau_exam
NOTIFICATION_DB_PASSWORD=replace-with-postgres-password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-redis-password

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=hau_exam
RABBITMQ_PASSWORD=replace-with-rabbitmq-password
USER_REGISTRATION_RETRY_DELAY_MS=5000
QUESTION_RETRY_DELAY_MS=10000
QUESTION_MAX_RETRIES=3
NOTIFICATION_RETRY_DELAY_MS=5000
NOTIFICATION_SCHEDULER_DELAY_MS=5000

# Eureka
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
EUREKA_INSTANCE_HOSTNAME=localhost

# JWT
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_GENERATE_EPHEMERAL_KEY=true
JWT_KEY_ID=hau-exam-auth-key
JWT_ISSUER=hau-exam-auth
JWT_JWK_SET_URI=http://localhost:8081/.well-known/jwks.json
DOCKER_JWT_JWK_SET_URI=http://auth-service:8081/.well-known/jwks.json
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D
BCRYPT_STRENGTH=12

# Internal Service
INTERNAL_SERVICE_TOKEN=replace-with-internal-service-token
AI_SERVICE_URL=http://localhost:8085
QUESTION_SERVICE_URL=http://localhost:8083

# SMTP
SMTP_HOST=localhost
DOCKER_SMTP_HOST=host.docker.internal
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS_ENABLED=false
SMTP_STARTTLS_REQUIRED=false
SMTP_FROM=no-reply@hau.edu.vn

# AI
AI_API_KEY=replace-with-ai-provider-api-key
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=
AI_STORAGE_ROOT=./data/ai-documents
AI_DOCUMENT_MAX_SIZE_BYTES=10485760
AI_RETRY_DELAY_MS=10000
AI_MAX_RETRIES=3
AI_CONSUMER_CONCURRENCY=1

# Web
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_BASE_URL=ws://localhost:8080
VITE_AI_DOCUMENT_MAX_SIZE_BYTES=10485760

# Mobile
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
EXPO_PUBLIC_WS_BASE_URL=ws://localhost:8080
EXPO_PUBLIC_EXPO_PROJECT_ID=
EXPO_PUSH_ENABLED=false
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
